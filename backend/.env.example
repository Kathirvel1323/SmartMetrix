# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/smartmetrix

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Admin Bootstrap (Used by npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@smartmetrix.local
ADMIN_PASSWORD=

# AI Service Integration (FastAPI Microservice)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=your_ai_service_secret_token_min_32_chars
AI_SERVICE_TIMEOUT_MS=5000

# Phase 8 Digital Certificate & Public Verification
PUBLIC_APP_URL=http://localhost:3000
CERTIFICATE_INTEGRITY_SECRET=your_certificate_integrity_hmac_secret_key_32_chars
COMPLAINT_ENCRYPTION_KEY=your_32_byte_aes_encryption_key_hex_64_chars
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX_REQUESTS=10

# Phase 9 Demo Data Generator
DEMO_DATA_PASSWORD=
